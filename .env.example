# 이 파일을 .env 로 복사한 뒤 키만 채우세요. 실제 키는 .env 에만 넣고 공유하지 않습니다.
# 공공데이터포털(data.go.kr) 마이페이지의 「디코딩 키」(% 문자가 없는 쪽)를 사용합니다.

# 관세청 품목별 국가별 수출입실적(GW), 관세청 관세환율정보(GW) 공용 키
DATA_GO_KR_KEY=

# 서비스별 키가 다르게 발급된 경우에만 아래를 채웁니다(비어 있으면 위 키를 사용)
DATA_GO_KR_KEY_TRADE=
DATA_GO_KR_KEY_FX=

# (선택) 없으면 제품 정보 직접 입력 모드로 동작
LLM_API_KEY=
